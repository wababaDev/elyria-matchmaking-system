SITE_URL=https://uat.example.com
DATABASE_URL=postgres://elyria_uat:change-me@host.docker.internal:5432/elyria_uat
GUNICORN_WORKERS=3

# ---- Email (Zoho)
EMAIL_HOST=smtppro.zoho.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
